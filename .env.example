# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
DB_NAME=
COLLECTION_NAME=

# ── Authentication ─────────────────────────────────────────────────────────────
# Must match JWT_SECRET in the auth microservice
JWT_SECRET=your-jwt-secret-here

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=
QUERY_MODEL=
JUDGE_MODEL=

# ── Groq (optional — required only when PROVIDER=groq) ────────────────────────
GROQ_API_KEY=gsk_...
GROQ_QUERY_MODEL=
GROQ_JUDGE_MODEL=

# ── Vector Search ──────────────────────────────────────────────────────────────
VECTOR_INDEX=
CANDIDATES=
VECTOR_SCORE_THRESHOLD=

# ── Provider ───────────────────────────────────────────────────────────────────
# Active LLM provider: "openai", "groq", or "gemini"
PROVIDER=

# ── Judge ──────────────────────────────────────────────────────────────────────
# Use JSON mode for judge output (more reliable parsing). Set to "true" to enable.
USE_JSON_JUDGE=false

# ── Embedding provider ─────────────────────────────────────────────────────────
# Active embedding provider: "openai" (default) or "gemini"
EMBEDDING_PROVIDER=openai

# ── Qdrant (optional — required only when EMBEDDING_PROVIDER=gemini) ───────────
QDRANT=https://<host>
QDRANT_API_KEY=
QDRANT_COLLECTION=precedentes_gemini

# ── Gemini / AI Studio (optional — required only when PROVIDER=gemini or EMBEDDING_PROVIDER=gemini) ──
AI_STUDIO_API_KEY=AIza...
GEMINI_QUERY_MODEL=gemini-2.0-flash
GEMINI_JUDGE_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# ── Langfuse (observability) ───────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com
